# ==========================================================
# ImmortalWrt 固件配置 — FriendlyARM NanoPi R3S (rockchip/armv8)
# 功能：LuCI 中文 + luci-app-daed + luci-app-upnp
#       + luci-app-passwall（NaiveProxy 协议支持）+ 在线安装软件
# ==========================================================

# ---- 目标设备 ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r3s=y

# ---- 根文件系统分区大小（MB），加大到 1GB 方便后续在线装软件 ----
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---- LuCI 中文界面 ----
CONFIG_LUCI_LANG_zh_Hans=y

# ---- UPnP ----
CONFIG_PACKAGE_luci-app-upnp=y

# ---- daed（eBPF 透明代理）----
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_libcron=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# daed 运行必需的内核 eBPF / BTF 支持
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
# CONFIG_BPF_TOOLCHAIN_NONE is not set
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_XDP_SOCKETS=y

# ---- NaiveProxy 协议（passwall 提供图形界面，naive 由官方 packages 源提供）----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_naiveproxy=y
